#!/usr/bin/with-contenv bash

for f in 'bin' 'lib' 'runtime' 'launcher-modules' ; do \
    if [ ! -e /app/launchserver/${f} ]; then
        echo "
        **** missing ${f}. copying defaults ****
        "
        cp -Rfv \
            /defaults/${f} \
            /app/launchserver/
    fi
done
    
chown -R \
  abc:abc \
    /app/launchserver

echo "**** libs checked ****"
